generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  user
  admin
}

enum UserStatus {
  active
  suspended
  unverified
}

enum AuctionStatus {
  draft
  active
  ended
  cancelled
}

enum TransactionStatus {
  pending
  completed
  failed
  refunded
}

enum NotificationType {
  outbid
  won
  payment_failed
  system
  auction_started
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  email            String     @unique @db.VarChar(255)
  passwordHash     String?    @map("password_hash") @db.VarChar(255)
  authProvider     String     @default("local") @map("auth_provider") @db.VarChar(50)
  fullName         String     @map("full_name") @db.VarChar(100)
  role             UserRole   @default(user)
  status           UserStatus @default(unverified)
  avatarUrl        String?    @map("avatar_url") @db.Text
  stripeCustomerId String?    @map("stripe_customer_id") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  auctionsAsSeller     Auction[]      @relation("AuctionSeller")
  auctionsAsWinner     Auction[]      @relation("AuctionWinner")
  bids                 Bid[]
  transactionsAsBuyer  Transaction[]  @relation("TransactionBuyer")
  transactionsAsSeller Transaction[]  @relation("TransactionSeller")
  notifications        Notification[]
  watchlists           Watchlist[]

  @@map("users")
}

model Auction {
  id          String @id @default(uuid()) @db.Uuid
  sellerId    String @map("seller_id") @db.Uuid
  title       String @db.VarChar(255)
  description String @db.Text
  category    String @db.VarChar(100)

  startingPrice     Decimal  @map("starting_price") @db.Decimal(12, 2)
  currentHighestBid Decimal? @default(0.00) @map("current_highest_bid") @db.Decimal(12, 2)
  minIncrement      Decimal  @map("min_increment") @db.Decimal(10, 2)

  startTime DateTime @map("start_time") @db.Timestamptz
  endTime   DateTime @map("end_time") @db.Timestamptz

  status   AuctionStatus @default(draft)
  winnerId String?       @map("winner_id") @db.Uuid

  imageUrl                    String? @map("image_url") @db.Text
  requiresPaymentVerification Boolean @default(true) @map("requires_payment_verification")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  seller        User          @relation("AuctionSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  winner        User?         @relation("AuctionWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  bids          Bid[]
  transactions  Transaction[]
  watchlistedBy Watchlist[]

  @@index([status, endTime])
  @@index([category])
  @@index([sellerId])
  @@map("auctions")
}

model Bid {
  id        String  @id @default(uuid()) @db.Uuid
  auctionId String  @map("auction_id") @db.Uuid
  bidderId  String  @map("bidder_id") @db.Uuid
  amount    Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder  User    @relation(fields: [bidderId], references: [id], onDelete: Cascade)

  @@index([auctionId, amount(sort: Desc)])
  @@map("bids")
}

model Transaction {
  id        String @id @default(uuid()) @db.Uuid
  auctionId String @map("auction_id") @db.Uuid
  buyerId   String @map("buyer_id") @db.Uuid
  sellerId  String @map("seller_id") @db.Uuid

  amount                Decimal           @db.Decimal(12, 2)
  stripePaymentIntentId String?           @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  status                TransactionStatus @default(pending)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  auction Auction @relation(fields: [auctionId], references: [id])
  buyer   User    @relation("TransactionBuyer", fields: [buyerId], references: [id])
  seller  User    @relation("TransactionSeller", fields: [sellerId], references: [id])

  @@map("transactions")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  type        NotificationType
  title       String           @db.VarChar(255)
  message     String           @db.Text
  isRead      Boolean          @default(false) @map("is_read")
  referenceId String?          @map("reference_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Watchlist {
  userId    String   @map("user_id") @db.Uuid
  auctionId String   @map("auction_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@id([userId, auctionId])
  @@map("watchlists")
}
