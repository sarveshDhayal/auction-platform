# ==============================================================================
# BIDMASTER - ENVIRONMENT VARIABLES
# ==============================================================================
# ⚠️ Do NOT commit the actual .env file to version control.
# Duplicate this file as '.env' and fill in the values.

NODE_ENV=development
PORT=5000

# ==============================================================================
# NEON POSTGRESQL DATABASE
# ==============================================================================
# Retrieve this from your Neon Dashboard: Projects -> Project Name -> Dashboard -> Connection Details
# Ensure you select the "Pooled connection" string for better serverless performance.
DATABASE_URL="postgres://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require"

# ==============================================================================
# REDIS (For Countdown Timers & Session Cache)
# ==============================================================================
# Example: Upstash Redis connection string
REDIS_URL="redis://default:[password]@[upstash_hostname]:[port]"

# ==============================================================================
# AUTHENTICATION
# ==============================================================================
# Use a strong, randomly generated string for JWT
JWT_SECRET="generate_a_secure_random_string_here_like_openssl_rand_base64_32"
JWT_EXPIRES_IN="7d"

# ==============================================================================
# STRIPE PAYMENT INTEGRATION
# ==============================================================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CURRENCY="usd"

# ==============================================================================
# NODEMAILER (Email Notifications)
# ==============================================================================
# Use AWS SES, SendGrid, or Gmail App Passwords
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="your_smtp_password"
EMAIL_FROM="BidMaster Notifications <noreply@bidmaster.com>"

# ==============================================================================
# CLIENT URL (CORS)
# ==============================================================================
CLIENT_URL="http://localhost:5173"
